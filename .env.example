REPLICATE_API_TOKEN=r8_REPLACE_ME
REPLICATE_VERSION=zhouhaojiang/qwen_32b:94378aca5cdf8fb28951d729424b636737017abc9eb9e843bd710ff4169db012

MODEL_NAME=qwen_32b
BRIDGE_API_KEY=change-me-long-random-value
ADMIN_TOKEN=change-me-another-long-random-value

LITELLM_NETWORK=litellm_default

# Keepalive always starts OFF after container startup.
# Enable it only through POST /admin/keepalive/start.
KEEPALIVE_INTERVAL_SECONDS=120
KEEPALIVE_CHECK_SECONDS=10

REPLICATE_MAX_WAIT_SECONDS=180
REPLICATE_POLL_SECONDS=1
REPLICATE_MAX_CREATE_RETRIES=3
REPLICATE_RATE_LIMIT_BUFFER_SECONDS=0.25

DEFAULT_MAX_TOKENS=1024
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.9
DEFAULT_TOP_K=50

LOG_LEVEL=INFO
